    "test:e2e": "node node_modules/@playwright/test/cli.js test",
    "lint": "node node_modules/oxlint/bin/oxlint . --fix && node node_modules/eslint/bin/eslint.js . --fix --cache",
    "lint:oxlint": "node node_modules/oxlint/bin/oxlint . --fix",
    "lint:eslint": "node node_modules/eslint/bin/eslint.js . --fix --cache",
    "format": "prettier --write --experimental-cli src/"
  },
  "dependencies": {
    "@stripe/stripe-js": "^9.15.0",
    "@supabase/supabase-js": "^2.115.0",
    "@unhead/vue": "^3.4.0",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.0.3",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.42",
    "vue-router": "^5.3.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vitejs/plugin-vue-jsx": "^5.1.6",
    "@vitest/eslint-plugin": "^1.6.27",
    "@vue/test-utils": "^2.5.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-oxlint": "^1.81.0",
    "eslint-plugin-playwright": "^2.11.0",
    "eslint-plugin-vue": "^10.10.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "npm-run-all2": "^9.0.3",
    "oxlint": "^1.81.0",
    "prettier": "^3.9.6",
    "supabase": "^2.116.0",
    "vite": "^8.2.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Stripe Configuration
VITE_STRIPE_PUBLIC_KEY=pk_test_your_key_here
STRIPE_SECRET_KEY=sk_test_your_key_here

# Application URLs
VITE_APP_URL=http://localhost:5173

# Email Configuration (Optional)
SUPABASE_SMTP_SENDER=noreply@yourdomain.com

# Web Push Notifications (VAPID)
# Générer avec : node scripts/generate-vapid.mjs
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# Mode maintenance — mettre à 'true' (string) pour activer (Netlify dashboard ou .env.local)
# Mettre à false ou supprimer pour désactiver. Note: '1', 'yes', 'True' ne fonctionnent PAS.
VITE_MAINTENANCE_MODE=false
